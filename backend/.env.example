# Plantilla de variables de entorno. Copia este archivo a ".env" y rellena
# los valores reales. ".env" está en .gitignore y NUNCA debe comitearse.

# Supabase (Postgres). Ver Settings > Database > Connection string en el
# dashboard del proyecto. Considera el connection pooler (puerto 6543) si
# tu pool de conexiones (HikariCP) agota conexiones directas.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Supabase Storage
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_BUCKET=audios-reuniones
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (transcripción Whisper / resumen)
OPENAI_API_KEY=

# Firebase Cloud Messaging (si aplica)
FIREBASE_CREDENTIALS_PATH=

# Servidor
PORT=8080
