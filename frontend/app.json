{
  "expo": {
    "name": "App de Actas",
    "slug": "actas-app",
    "version": "0.1.0",
    "scheme": "actasapp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "La app necesita el micrófono para grabar las reuniones."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "La app necesita el micrófono para grabar las reuniones."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F6",
          "dark": {
            "backgroundColor": "#0B0B0D"
          },
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
