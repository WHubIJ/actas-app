{
  "expo": {
    "name": "App de Actas",
    "slug": "actas-app",
    "version": "0.1.0",
    "scheme": "actasapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "La app necesita el micrófono para grabar las reuniones."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "La app necesita el micrófono para grabar las reuniones."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ]
  }
}
